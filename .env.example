# Copy this file to ".env" (already gitignored) and fill in real values for local development.
# Never commit ".env" or real secrets to source control.

# Local-development-only admin credentials for the Seq container (docker-compose.yml).
SEQ_ADMIN_USERNAME=admin
SEQ_ADMIN_PASSWORD=change-me-locally

# Backend -> Seq wiring (see FEA.URVP.Backend/Program.cs).
# Point the API at the ingestion endpoint exposed by docker-compose.yml.
SEQ_SERVER_URL=http://localhost:5342
# Optional: only required if the target Seq instance enforces an API key for ingestion.
# SEQ_API_KEY=
