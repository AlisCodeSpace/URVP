{
  "ConnectionStrings": {
    "SqlServerConnection": "Server=localhost;Database=FEA_URVP;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=True"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Authentication": "Information",
        "Microsoft.AspNetCore.Authentication.OpenIdConnect": "Information",
        "FEA.URVP.Api.Security": "Information"
      }
    }
  },
  "Seq": {
    "ServerUrl": "",
    "ApiKey": ""
  },
  "AllowedHosts": "*",
  "Auth": {
    "Cookie": {
      "ExpireHours": 8,
      "SlidingExpiration": true
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "mail.aub.edu",
    "CallbackPath": "/signin-oidc-ad",
    "FrontendCallbackPath": "/auth/callback"
  },
  "Ldap": {
    "Enabled": true,
    "Server": "win2k.aub.edu.lb",
    "Port": 3268,
    "BaseDn": "DC=aub,DC=edu,DC=lb",
    "FacultyGroupName": "ALLACADstaff-STF",
    "StudentGroupName": "Students-STD"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "SeedCatalogsOnStartup": true
  },
  "AdminEmails": [],
  "FileStorage": {
    "MaxImageSizeBytes": 2097152,
    "MaxPdfSizeBytes": 10485760,
    "MaxTotalSizeBytes": 26214400
  },
  "NotificationSettings": {
    "MaxUnreadNotifications": 100
  },
  "NotificationCache": {
    "ExpirationMinutes": 5
  },
  "Email": {
    "Enabled": false,
    "From": "noreply@mail.aub.edu",
    "FromName": "FEA Undergraduate Research Volunteer Program",
    "PortalSignInUrl": "",
    "SignInActionText": "Sign in to URVP",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "UserName": "",
      "Password": ""
    },
    "SmtpFallback": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "UserName": "",
      "Password": ""
    }
  },
  "Security": {
    "Frontend": {
      "Enabled": true,
      "RootPath": "wwwroot"
    },
    "ContentSecurityPolicy": {
      "ReportOnly": false,
      "ReportPath": "/api/security/csp-report",
      "ConnectSrc": [],
      "ImgSrc": [],
      "FontSrc": [],
      "FrameSrc": [],
      "FrameAncestors": [],
      "FormAction": []
    },
    "Hsts": {
      "MaxAgeDays": 365,
      "IncludeSubDomains": false,
      "Preload": false
    },
    "TrustedProxies": {
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1,
      "TrustAnyProxy": false
    },
    "RateLimiting": {
      "GlobalPermitPerMinute": 600,
      "AuthPermitPerMinute": 120,
      "UploadPermitPerMinute": 30,
      "DownloadPermitPerMinute": 240,
      "ReportPermitPerMinute": 20,
      "QueueLimit": 0
    },
    "Health": {
      "MonitoringNetworks": []
    }
  }
}
