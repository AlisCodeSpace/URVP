{
  "AllowedHosts": "urvp.aub.edu.lb;www.urvp.aub.edu.lb",

  "ConnectionStrings": {
    "SqlServerConnection": "Server=soldext-srv.win2k.aub.edu.lb;Database=FEA_URVP;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=True"
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Auth": {
    "EnableDevSignIn": false
  },

  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedCatalogsOnStartup": false
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "mail.aub.edu",
    "TenantId": "c7ba5b1a-41b6-43e9-a120-6ff654ada137",
    "ClientId": "b1fad39c-248e-4196-a98f-39c3dbabda2c",
    "CallbackPath": "/signin-oidc-ad",
    "FrontendCallbackPath": "/auth/callback",
    "ForceAccountSelection": true
  },

  "Email": {
    "Enabled": true,
    "From": "urvp-system@aub.edu.lb",
    "FromName": "FEA Undergraduate Research Volunteer Program",
    "PortalSignInUrl": "https://urvp.aub.edu.lb",
    "Smtp": {
      "Host": "smtp.aub.edu.lb",
      "Port": 25,
      "EnableSsl": false,
      "UserName": ""
    },
    "SmtpFallback": {
      "Host": "localhost",
      "Port": 25,
      "EnableSsl": false
    }
  },

  "Security": {
    "Frontend": {
      "Enabled": true,
      "RootPath": "wwwroot"
    },
    "ContentSecurityPolicy": {
      "ReportOnly": false,
      "ReportPath": "/api/security/csp-report",
      "ConnectSrc": [],
      "ImgSrc": [],
      "FontSrc": [],
      "FrameSrc": [],
      "FrameAncestors": [],
      "FormAction": []
    },
    "Hsts": {
      "MaxAgeDays": 365,
      "IncludeSubDomains": false,
      "Preload": false
    },
    "TrustedProxies": {
      "KnownProxies": [ "127.0.0.1", "::1" ],
      "KnownNetworks": [],
      "ForwardLimit": 1,
      "TrustAnyProxy": false
    },
    "Health": {
      "MonitoringNetworks": []
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Authentication": "Warning",
        "Microsoft.AspNetCore.Authentication.OpenIdConnect": "Warning",
        "FEA.URVP.Api.Security": "Information"
      }
    }
  }
}
