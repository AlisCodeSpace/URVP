<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / ANCM host for the same-origin BFF.

  ASPNETCORE_ENVIRONMENT is deliberately not set here. A value in this file would be
  wiped on every unzip. Set it once at the IIS site in applicationHost.config (the
  deploy script does this with /commit:apphost) so it survives wipe-and-unzip. The
  same script also writes it into the published web.config after each copy so a
  brand-new box still boots on the first deploy.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\FEA.URVP.Backend.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering removeServerHeader="true" />
      </security>
    </system.webServer>
  </location>
</configuration>
