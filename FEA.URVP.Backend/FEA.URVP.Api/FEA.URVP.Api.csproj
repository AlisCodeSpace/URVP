<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Host project owns appsettings / launchSettings; this is a library only. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <!-- Pinned above the version Microsoft.AspNetCore.OpenApi 10.0.2 pulls in transitively:
         2.0.0 is affected by GHSA-v5pm-xwqc-g5wc (CVE-2026-49451), patched in 2.7.5. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FEA.URVP.Application\FEA.URVP.Application.csproj" />
    <ProjectReference Include="..\FEA.URVP.Infrastructure\FEA.URVP.Infrastructure.csproj" />
  </ItemGroup>

</Project>
