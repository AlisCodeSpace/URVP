<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FEA.URVP.Domain\FEA.URVP.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="MediatR" Version="12.5.0" />
  </ItemGroup>

  <!--
    AUB.MimeDetective is copied under the host web project. Compiling those sources
    into this assembly lets MimeTypeValidator use stream.GetFileType() without a
    NuGet package or ProjectReference. The host excludes the same files so types
    are not duplicated.
  -->
  <ItemGroup>
    <Compile Include="..\AUB.MimeDetective\**\*.cs" Link="AUB.MimeDetective\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\AUB.MimeDetective\bin\**\*.cs;..\AUB.MimeDetective\obj\**\*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
